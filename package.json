{
  "name": "configkit-windows",
  "version": "1.0.0",
  "description": "ConfigKit desktop application for Windows, macOS and Linux",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:icons": "node desktop/create-icons.cjs",
    "dist:win": "npm run build:icons && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:icons && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "npm run build:icons && electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "sharp": "0.34.5",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "com.configkit.desktop",
    "productName": "ConfigKit",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "build/icon.png",
      "android/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ConfigKit-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ConfigKit",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ConfigKit-macOS-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ConfigKit-Linux-${arch}.${ext}",
      "category": "Utility"
    }
  },
  "author": "ConfigKit Project"
}
